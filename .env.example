# Postgres (container em deploy/compose.yml expõe a porta 5433)
DATABASE_URL=postgres://sleeper:sleeper@localhost:5433/sleeper
# Usado pelos testes de integração
TEST_DATABASE_URL=postgres://sleeper:sleeper@localhost:5433/sleeper_test

# Sleeper
SLEEPER_USERNAME=
LEAGUE_ID=
# IDs separados por vírgula; auto descobre todas as ligas NFL da temporada
LEAGUE_IDS=
# Opcional: header `authorization` do sleeper.com (DevTools → Network → graphql). Habilita `claims`.
SLEEPER_TOKEN=

# Telegram: crie o bot no @BotFather; o chat_id é descoberto por `pnpm cli setup`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TZ=America/Sao_Paulo
LOG_LEVEL=info
