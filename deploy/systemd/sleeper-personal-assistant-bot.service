[Unit]
Description=Sleeper Personal Assistant: bot do Telegram (outbox + comandos)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=@APP_DIR@
Environment=PATH=@NODE_DIR@:/usr/bin:/bin
ExecStart=@NODE_DIR@/node --import tsx src/cli.ts bot
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
