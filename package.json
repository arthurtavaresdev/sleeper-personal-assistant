{
  "name": "sleeper-trader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "migrate": "node-pg-migrate -m migrations -j sql --envPath .env",
    "db:up": "podman compose -f deploy/compose.yml up -d",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.8",
    "javascript-lp-solver": "^1.0.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
